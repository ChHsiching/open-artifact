{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/skills/open-artifact/scripts/open-artifact.mjs\" hook sessionStart --harness cursor",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/skills/open-artifact/scripts/open-artifact.mjs\" hook stop --harness cursor",
        "timeout": 30,
        "loop_limit": 10
      }
    ]
  }
}
